default_platform :ios

require 'base64'
require 'fileutils'
require 'googleauth'
require 'json'
require 'spaceship'

APP_STORE_CONNECT_API_KEY_ID = ENV["APP_STORE_CONNECT_API_KEY_ID"]
APP_STORE_CONNECT_API_KEY_ISSUER_ID = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
APP_STORE_CONNECT_API_PRIVATE_KEY_CONTENT = ENV["APP_STORE_CONNECT_API_PRIVATE_KEY_CONTENT"]
BAZEL_LOCAL_CACHE = ENV["BAZEL_LOCAL_CACHE"]
BAZEL_PATH = ENV["BAZEL_PATH"]
BAZEL_REMOTE_CACHE = ENV["BAZEL_REMOTE_CACHE"]
BAZEL_USER_ROOT = ENV["BAZEL_USER_ROOT"]
BUILD_WORKING_DIR = ENV["BUILD_WORKING_DIR"]
BUNDLE_ID = ENV["BUNDLE_ID"]
GOOGLE_APPLICATION_CREDENTIALS_BASE64 = ENV["GOOGLE_APPLICATION_CREDENTIALS_BASE64"] 
KEYCHAIN_NAME = ENV["KEYCHAIN_NAME"]
KEYCHAIN_PASSWORD = ENV["KEYCHAIN_PASSWORD"]
#
# Nicegram Build cache
# Distribution (appstore, et al.) match gets its own ephemeral keychain,
# derived from KEYCHAIN_NAME so no env file needs a new variable. Keeping it
# separate from the developer's login keychain -- where `match development`
# installs -- is the point: see nicegram_match below for why they must never
# be the same keychain.
#
DISTRIBUTION_KEYCHAIN = "#{KEYCHAIN_NAME}-distribution"
SIGN_URL = ENV["SIGN_URL"]
SOURCE_PATH = ENV["SOURCE_PATH"] || File.expand_path("../..", __dir__)
TEAM_ID = ENV["TEAM_ID"]
TELEGRAM_BOT_TOKEN = ENV["TELEGRAM_BOT_TOKEN"]
TELEGRAM_CONFIGURATION_TEST = ENV["TELEGRAM_CONFIGURATION_TEST"]
TELEGRAM_CONFIGURATION_PROD = ENV["TELEGRAM_CONFIGURATION_PROD"]
TELEGRAM_CHAT_ID = ENV["TELEGRAM_CHAT_ID"]
TELEGRAM_WATCHOS_APP_ID = ENV["TELEGRAM_WATCHOS_APP_ID"]
TELEGRAM_WATCHOS_APP_HASH = ENV["TELEGRAM_WATCHOS_APP_HASH"]

base_app_identifier_llc = BUNDLE_ID || "app.nicegram"
app_identifier_llc = [
  base_app_identifier_llc,
  base_app_identifier_llc + ".Widget",
  base_app_identifier_llc + ".NotificationContent",
  base_app_identifier_llc + ".SiriIntents",
  base_app_identifier_llc + ".Share",
  base_app_identifier_llc + ".NotificationService",
  base_app_identifier_llc + ".watchkitapp",
  base_app_identifier_llc + ".BroadcastUpload"
]

# Nicegram Build cache
# One place that assembles the Make.py invocation prefix.
#
# Three lanes used to build this independently and had already drifted:
# generate_project passed only --cacheDir, omitting --bazel, --bazelUserRoot and
# --cacheHost. Harmless while those env vars are unset, but the day anyone sets
# BAZEL_USER_ROOT the Xcode flow lands in a different bazel output root and
# shares no cache with the other two -- a silent, expensive divergence.
#
# Note that Make.py itself treats cacheDir and cacheHost as mutually exclusive
# (`if cacheDir ... elif cacheHost`), so passing both leaves the local disk
# cache winning. That is pre-existing behaviour and is preserved here
# deliberately; changing it is not in this feature's scope.
def make_py_prefix
  parts = ["cd \"#{SOURCE_PATH}\" && python3 build-system/Make/Make.py"]
  parts << "--bazel=#{BAZEL_PATH}" unless BAZEL_PATH.nil?
  parts << "--bazelUserRoot=#{BAZEL_USER_ROOT}" unless BAZEL_USER_ROOT.nil?
  parts << "--cacheDir=#{BAZEL_LOCAL_CACHE}" unless BAZEL_LOCAL_CACHE.nil?
  parts << "--cacheHost=#{BAZEL_REMOTE_CACHE}" unless BAZEL_REMOTE_CACHE.nil?
  parts.join(" ")
end
#

lane :beta_build do |options|
  # A local build passes the number so the Confluence row, the Jira comment and
  # the build in TestFlight agree by construction. CI passes nothing and keeps
  # computing it here, which is the only source when nobody is watching.
  supplied = options[:build_number]
  # Refused rather than coerced: an empty string is truthy in Ruby, so `||`
  # never reaches the fallback, and `"".to_i` / `"abc".to_i` are both 0 --
  # a build 0 uploaded to TestFlight under the version the caller asked for.
  unless supplied.nil? || supplied.to_s.strip.match?(/\A\d+\z/)
    UI.user_error!("build_number: #{supplied.inspect} is not a build number")
  end
  build(
    build_number: (supplied || latest_testflight_build_number(
      api_key: generate_app_store_connect_api_key(),
      app_identifier: BUNDLE_ID
    ) + 1).to_i,
    embed_watch_app: true,
    upload_to_tf: true
  )

  upload_dsyms()
end

lane :master_build do |options|
  versions = JSON.parse(File.read("#{SOURCE_PATH}/versions.json"))
  app_version = versions["app"]

  build_number = app_store_build_number(
    api_key: generate_app_store_connect_api_key(),
    app_identifier: BUNDLE_ID,
    version: app_version
  )

  sh("echo BUILD_NUMBER=#{build_number} >> $GITHUB_ENV")

  build(
    build_number: build_number,
    # Public GitHub-release IPA: do not embed the watch app so its API
    # credentials are not exposed in the downloadable bundle's Info.plist.
    embed_watch_app: false,
    upload_to_tf: false
  )
end

lane :tg_report_release do |options|
  version = options[:version]
  build = options[:build]
  release_url = options[:release_url]

  install_ipa_guide_url = "https://medium.com/@pancakeufo/how-to-install-nicegram-on-your-jailbroken-ios-device-1b8f9f2b5afa"

  tg(
    message: ""\
    "Nicegram v#{version} (#{build}) -> [Download](#{release_url})\n\n"\
    "How to install .ipa -> [Read here](#{install_ipa_guide_url})",
    parse_mode: "Markdown"
  )
end

lane :build do |options|
  build_number = options[:build_number]
  # The embedded watch app bakes the watch API id/hash into a plaintext Info.plist.
  # Only embed it for TestFlight (Apple-gated) builds; the public GitHub-release IPA
  # from master_build must not ship those credentials.
  embed_watch_app = options[:embed_watch_app]
  upload_to_tf = options[:upload_to_tf]

  # Match because Telegram script doesnt import certificates
  nicegram_match(
    type: "appstore"
  )

  telegram_configuration_path = resolve_telegram_configuration(
    is_appstore_build: upload_to_tf
  )

  update_remote_config_defaults()

  ensure_xcode_symlink()

  # Build
  ipa_path = build_bazel(
    build_number: build_number,
    configuration_path: telegram_configuration_path,
    git_codesigning_repository: SIGN_URL,
    git_codesigning_type: "appstore",
    embed_watch_app: embed_watch_app
  )

  # Upload to testflight
  if upload_to_tf
    upload_ipa(ipa: ipa_path)
  end

  # Nicegram Build cache: distribution keychain only -- see nicegram_match.
  delete_keychain_if_exists(name: DISTRIBUTION_KEYCHAIN)
end

lane :resolve_telegram_configuration do |options|
  is_appstore_build = options[:is_appstore_build] || true

  telegram_configuration_path = "#{BUILD_WORKING_DIR}/telegram-configuration.json"

  env_path = "#{SOURCE_PATH}/ng-env.txt"
  env = File.read(env_path)
  telegram_configuration_base64 = ""
  if env == "test"
    telegram_configuration_base64 = TELEGRAM_CONFIGURATION_TEST
  elsif env == "prod"
    telegram_configuration_base64 = TELEGRAM_CONFIGURATION_PROD
  else
    raise "Unknown environment in #{env_path}"
  end

  telegram_configuration_string = Base64.decode64(telegram_configuration_base64)
  
  telegram_configuration = JSON.parse(telegram_configuration_string)
  telegram_configuration["is_appstore_build"] = is_appstore_build

  # BUILD_WORKING_DIR (ci/working_dir) is untracked and does not exist in a
  # fresh worktree -- create it before writing into it rather than assuming
  # some earlier run already left it behind.
  FileUtils.mkdir_p(BUILD_WORKING_DIR)
  File.write(telegram_configuration_path, JSON.pretty_generate(telegram_configuration))

  telegram_configuration_path
end

lane :build_bazel do |options|
  build_number = options[:build_number]
  configuration_path = options[:configuration_path]
  git_codesigning_repository = options[:git_codesigning_repository]
  git_codesigning_type = options[:git_codesigning_type]
  embed_watch_app = options[:embed_watch_app]

  artifacts_path = "#{BUILD_WORKING_DIR}/artifacts"
  FileUtils.rm_rf(artifacts_path)
  # mkdir_p, not mkdir: BUILD_WORKING_DIR itself may not exist yet either
  # (untracked, absent in a fresh worktree) -- plain mkdir fails when its
  # parent is missing.
  FileUtils.mkdir_p(artifacts_path)

  shell_command = "#{make_py_prefix} "

  shell_command += "build \
  --configurationPath=#{configuration_path} \
  --gitCodesigningRepository=#{git_codesigning_repository} \
  --gitCodesigningType=#{git_codesigning_type} \
  --buildNumber=#{build_number} \
  --configuration=release_arm64 \
  --outputBuildArtifactsPath=#{artifacts_path} "

  # Embed the companion Apple Watch app (release_arm64 is a device config, which is required
  # for embedding). When embedding is requested, the dedicated watch API credentials are
  # mandatory — fail loudly rather than silently shipping a build without the watch app.
  if !embed_watch_app
    UI.important("embed_watch_app=false — building without the embedded Apple Watch app (its API credentials would otherwise be exposed in the public IPA's plaintext Info.plist).")
  elsif TELEGRAM_WATCHOS_APP_ID.to_s.empty? || TELEGRAM_WATCHOS_APP_HASH.to_s.empty?
    UI.user_error!("embed_watch_app=true but TELEGRAM_WATCHOS_APP_ID/TELEGRAM_WATCHOS_APP_HASH are not set — cannot embed the Apple Watch app without watch API credentials.")
  else
    shell_command += "\
  --embedWatchApp \
  --watchApiId=#{TELEGRAM_WATCHOS_APP_ID} \
  --watchApiHash=#{TELEGRAM_WATCHOS_APP_HASH} "
  end

  error_callback = lambda do |result|
    raise "❌ Build script error\n#{result}"
  end

  sh shell_command, error_callback: error_callback

  ipa_path = "#{artifacts_path}/Telegram.ipa"
end

lane :generate_project do |options|
  configuration_path = resolve_telegram_configuration()

  ensure_xcode_symlink()

  # --headless: without it Make.py runs `killall Xcode` and opens the project,
  # and ci/verify-build.sh generates on the first run in every fresh worktree.
  sh "#{make_py_prefix} generateProject \
  --configurationPath=#{configuration_path} \
  --buildNumber=55555 \
  --gitCodesigningRepository=#{SIGN_URL} \
  --gitCodesigningType=development \
  --headless"
end

# Nicegram Build cache
# Resolves build-input/configuration-repository -- the local bazel module that
# carries variables.bzl (bundle ids, api id/hash, aps environment, and the
# absolute path to this checkout's bazel binary) and the provisioning profiles
# fetched from the codesigning repository -- WITHOUT building anything and
# WITHOUT generating an Xcode project.
#
# Why a lane of its own: ci/verify-build.sh no longer goes through `Make.py
# build`, so nothing else in its path would re-resolve the configuration. That
# matters for two reasons that both fail silently otherwise:
#   * flipping ng-env.txt between test and prod changes bundle ids and api
#     credentials; without re-resolution the gate would keep building the
#     previous environment's configuration and look perfectly healthy.
#   * `resolve_configuration` re-fetches the provisioning profiles on every
#     run (it deletes and repopulates the provisioning directory), which is
#     what keeps a device build's signing inputs current.
#
# `query` is the only Make.py subcommand that resolves the configuration and
# then does something cheap instead of building the app (Make.py:783-810). Its
# --queryArgs is required, so it gets the xcodeproj runner target, which is
# cheap to analyse -- the heavy analysis all happens in the generator target
# inside the nested output base, not here. `--output=summary` keeps it quiet:
# the default text output dumps the runner script's own source, which contains
# lines like `fail "ERROR: ..."` and reads alarmingly in a build log.
lane :resolve_config do |options|
  configuration_path = resolve_telegram_configuration()

  ensure_xcode_symlink()

  sh "#{make_py_prefix} query \
  --configurationPath=#{configuration_path} \
  --gitCodesigningRepository=#{SIGN_URL} \
  --gitCodesigningType=development \
  --queryArgs='--output=summary //Telegram:Telegram_xcodeproj'"
end
#

lane :compile_check do |options|
  # Nicegram Build cache
  # NOTHING IN THIS REPO CALLS THIS LANE. It is kept deliberately, and only for
  # hand invocation, the same way ci/nicegram-match.sh is -- do not delete it
  # because a grep says it is dead.
  #
  # ci/verify-build.sh stopped using it on 2026-08-28: the gate builds through
  # rules_xcodeproj's command-line API so that its actions share cache with
  # Xcode, and this lane cannot, by construction. It builds plain target labels,
  # which land in a different bazel configuration -- that is the whole finding
  # this branch rests on. Measured on this machine: a cold simulator label build
  # took 179s at 78% disk-cache hits, while the device one took 1114s at 0%,
  # because nothing else here builds a device label; the API path gets the same
  # work in seconds.
  #
  # So reach for it only to answer "is the API path itself broken, or is my code
  # broken?" -- and expect it to cost a full rebuild of the configuration it
  # builds, since nothing else populates it:
  #
  #   cd ci && fastlane compile_check configuration:debug_arm64
  #
  # If you find yourself running it twice, fix the API path instead.
  #
  # Use `options[:configuration] ||` deliberately: the value is always a
  # non-empty string or nil, so `||` cannot clobber a meaningful `false` the
  # way resolve_telegram_configuration's is_appstore_build bug does (tracked
  # separately).
  configuration = options[:configuration] || "debug_sim_arm64"
  #
  configuration_path = resolve_telegram_configuration()

  ensure_xcode_symlink()

  # Compile-only gate: no match, no upload. The device configuration does sign
  # the app and its extensions (it needs a resolved identity -- see
  # ci/verify-build.sh's pre-flight); the simulator configuration does not.
  # --continueOnError forwards to bazel's --keep_going so a merge that breaks
  # twenty modules reports all twenty in one pass instead of stopping at the
  # first.
  shell_command = "#{make_py_prefix} "
  shell_command += "build --continueOnError \
  --configurationPath=#{configuration_path} \
  --gitCodesigningRepository=#{SIGN_URL} \
  --gitCodesigningType=development \
  --buildNumber=55555 \
  --configuration=#{configuration}"

  sh shell_command, error_callback: lambda { |result| raise "❌ compile_check failed\n#{result}" }
end

lane :upload_ipa do |options|
  ipa_path = options[:ipa]

  upload_to_testflight(
    api_key: generate_app_store_connect_api_key(),
    ipa: ipa_path,
    skip_waiting_for_build_processing: true,
  )
end

lane :update_remote_config_defaults do |options|
  credentials_file_path = "./GOOGLE_APPLICATION_CREDENTIALS"
  File.write(
    credentials_file_path, 
    Base64.decode64(GOOGLE_APPLICATION_CREDENTIALS_BASE64)
  )

  scope = [
    "https://www.googleapis.com/auth/firebase.remoteconfig"
  ]

  auth = Google::Auth::ServiceAccountCredentials.make_creds(
    json_key_io: File.open(credentials_file_path),
    scope: scope
  )
  token = auth.fetch_access_token!["access_token"]
  
  sh "curl https://firebaseremoteconfig.googleapis.com/v1/projects/nicegram-55d94/remoteConfig:downloadDefaults?format=PLIST \
  --compressed \
  -H \"Authorization: Bearer #{token}\" \
  -o #{SOURCE_PATH}/Telegram/Telegram-iOS/FirebaseRemoteConfigDefaults.plist \
  "

  File.delete(credentials_file_path)
end

lane :nicegram_match do |options|
  type = options[:type]

  #
  # Nicegram Build cache
  # `development` used to share KEYCHAIN_NAME with every other type. A release
  # build (type: "appstore") runs ensure_temp_keychain on that same name,
  # which deletes and recreates it -- so the last step of every local release
  # build silently destroyed the developer's development signing certificate,
  # and `build`'s closing delete_keychain_if_exists (and the error handler on
  # any lane failure) deleted it outright. The developer then had to re-run
  # `ci/nicegram-match.sh development` by hand before the next Xcode device
  # build would codesign again.
  #
  # Fix: `development` now installs into the login keychain instead -- omit
  # keychain_name/keychain_password so `match` uses its default, and skip
  # ensure_temp_keychain entirely, since there is no ephemeral keychain to
  # create or tear down. This is not a stylistic choice: a *named* dev
  # keychain would still be wrong, because it locks after every reboot and
  # codesign needs the private key unlocked -- that would only trade "broken
  # after every release build" for "broken after every reboot". The login
  # keychain is the one macOS unlocks automatically at login.
  #
  # Every other type (appstore, ...) keeps today's ephemeral-keychain
  # behaviour unchanged, just on DISTRIBUTION_KEYCHAIN instead of
  # KEYCHAIN_NAME, so CI (which only ever passes type: "appstore") is
  # unaffected and distribution credentials still never linger.
  #
  if type == "development"
    match(
      type: type,
      app_identifier: app_identifier_llc,
      team_id: TEAM_ID,
      git_url: SIGN_URL,
      git_branch: TEAM_ID,
      api_key: generate_app_store_connect_api_key()
    )
  else
    ensure_temp_keychain(
      name: DISTRIBUTION_KEYCHAIN,
      password: KEYCHAIN_PASSWORD
    )

    match(
      type: type,
      app_identifier: app_identifier_llc,
      team_id: TEAM_ID,
      git_url: SIGN_URL,
      git_branch: TEAM_ID,
      api_key: generate_app_store_connect_api_key(),
      keychain_name: DISTRIBUTION_KEYCHAIN,
      keychain_password: KEYCHAIN_PASSWORD
    )
  end
end

lane :upload_dsyms do |options|
  upload_dsyms_to_crashlytics()
end

lane :upload_dsyms_to_crashlytics do |options|
  upload_symbols_to_crashlytics(
    binary_path: "#{SOURCE_PATH}/ci/upload-symbols",
    dsym_path: "#{BUILD_WORKING_DIR}/artifacts/Telegram.DSYMs.zip",
    gsp_path: "#{SOURCE_PATH}/Telegram/Telegram-iOS/GoogleService-Info.plist"
  )
end

lane :generate_app_store_connect_api_key do |options|
  app_store_connect_api_key(
    key_id: APP_STORE_CONNECT_API_KEY_ID,
    issuer_id: APP_STORE_CONNECT_API_KEY_ISSUER_ID,
    key_content: APP_STORE_CONNECT_API_PRIVATE_KEY_CONTENT
  )
end

lane :ensure_temp_keychain do |options|
  name = options[:name]
  password = options[:password]

  delete_keychain_if_exists(name: name)
  create_keychain(
    name: name,
    password: password,
    unlock: true,
    timeout: 0
  )
end

lane :delete_keychain_if_exists do |options|
  name = options[:name]

  delete_keychain(name: name) if File.exist?(File.expand_path("~/Library/Keychains/#{name}-db"))
end

lane :tg do |options|
  message = options[:message]
  parse_mode = options[:parse_mode]

  sh("curl -X POST \
     -H 'Content-Type: application/json' \
     -d '{\"chat_id\": \"#{TELEGRAM_CHAT_ID}\", \"text\": \"#{message}\", \"parse_mode\": \"#{parse_mode}\"}' \
     https://api.telegram.org/bot#{TELEGRAM_BOT_TOKEN}/sendMessage"
   )
end

lane :ensure_xcode_symlink do
  xcode_dev_path = sh("xcode-select -p").chomp
  xcode_path = xcode_dev_path.sub(%r{/Contents/Developer$}, '')
  symlink = "/Applications/Xcode.app"

  if !File.exist?(symlink)
    File.symlink(xcode_path, symlink)
  end
end

error do |_, _exception|
    # Nicegram Build cache: distribution keychain only -- see nicegram_match.
    delete_keychain_if_exists(name: DISTRIBUTION_KEYCHAIN)
end
